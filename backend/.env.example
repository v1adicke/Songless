# --- Spotify API credentials (OPTIONAL) ---
# Spotify is used for rich catalog search/filtering WHEN reachable. The game
# works fully without it: if these are blank or Spotify is unavailable in your
# region, the backend automatically uses the iTunes catalog instead.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Server config (local Bun dev only — Vercel manages the port/runtime)
PORT=3000

# Allowed CORS origin for the frontend.
# - Local Bun dev (src/index.ts) reads FRONTEND_ORIGIN.
# - Vercel serverless (api/index.ts) reads CORS_ORIGIN; it accepts a
#   comma-separated allowlist or "*". Set it to your deployed frontend
#   origin, e.g. https://songless.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=*
