# Base origin of the backend API (production / split deploys).
# Local dev: leave this UNSET — requests stay same-origin and Vite proxies
# `/api/*` to the Hono backend on :3000 (see vite.config.ts).
# Production (Vercel): set to your deployed backend origin, e.g.
# VITE_API_URL=https://songless-api.vercel.app
VITE_API_URL=
